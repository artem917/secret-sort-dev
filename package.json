{
  "name": "secret-sort-dev",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "verify:pages": "node scripts/verify-pages.mjs",
    "compare:difficulty": "node scripts/compare-difficulty.mjs",
    "build": "npm run typecheck && vite build && vite build --config vite.experimental.config.ts && vite build --config vite.v05.config.ts && vite build --config vite.v06.config.ts && node scripts/verify-stable.mjs && node scripts/verify-preserved-v04.mjs && node scripts/verify-preserved-v05.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "dev:v04": "vite --config vite.experimental.config.ts --host 127.0.0.1",
    "test:v04": "node --test tests/v04*.test.mjs",
    "experiment:v04": "node scripts/experiment-v04.mjs",
    "verify:pages:v04": "node scripts/verify-pages-v04.mjs",
    "playtest:v04": "node scripts/visible-play-v04.mjs",
    "dev:v05": "vite --config vite.v05.config.ts --host 127.0.0.1",
    "test:v05": "node --test tests/v05*.test.mjs",
    "certify:v05": "node scripts/certify-v05.mjs",
    "verify:pages:v05": "node scripts/verify-pages-v05.mjs",
    "dev:v06": "vite --config vite.v06.config.ts --host 127.0.0.1",
    "test:v06": "node --test tests/v06*.test.mjs",
    "certify:v06": "node scripts/certify-v06.mjs",
    "verify:pages:v06": "node scripts/verify-pages-v06.mjs"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
